{
  "name": "router-worker",
  "version": "0.1.0",
  "description": "A local, miniature super-agent: one router written as code, workers as agent sessions (Claude Code, Antigravity, DSH), one read-only watchdog. Least human attention, most value.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "rw": "bin/rw.mjs"
  },
  "main": "lib/plugin/dsh/index.js",
  "exports": {
    ".": "./lib/plugin/dsh/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "bin",
    "lib",
    "src",
    "plugin",
    "prompts",
    "skills",
    "templates",
    "docs",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./plugin/dsh/cordis.patch.yml"
    },
    "manifestVersion": 1
  },
  "scripts": {
    "rw": "node src/cli.ts",
    "test": "node --test \"tests/**/*.test.ts\"",
    "typecheck": "tsc -p tsconfig.json",
    "build": "tsc -p tsconfig.build.json",
    "check": "npm run typecheck && npm test",
    "smoke:claude": "node scripts/smoke.mjs --executor claude",
    "smoke:fake": "node scripts/smoke.mjs --executor fake"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "typescript": "^5.9.0"
  }
}
